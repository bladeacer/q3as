# Environment variables for Qwen3-8B model download
# Copy this file to .env and fill in your credentials
# The .env file is git-ignored; .env.dev is a committed template

# Hugging Face access token (required for gated model downloads)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Enable hf_transfer accelerated downloads (set to "1" to enable)
HF_HUB_ENABLE_HF_TRANSFER=1

# Disable XET protocol (set to "1" if experiencing XET issues)
HF_HUB_DISABLE_XET=1
