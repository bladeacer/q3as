# Environment variables for q3as base model downloads
# Copy this file to .env and fill in your credentials
# The .env file is git-ignored; .env.dev is a committed template

# Default model key for direct script runs (see docs/models.md).
# The Makefile's MODEL variable and the scripts' --model flag override this.
Q3AS_MODEL=qwen3-8b

# Hugging Face access token (required for gated model downloads)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Enable hf_transfer accelerated downloads (set to "1" to enable)
HF_HUB_ENABLE_HF_TRANSFER=1

# Disable XET protocol (set to "1" if experiencing XET issues)
HF_HUB_DISABLE_XET=1
